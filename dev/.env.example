## Core
APP_TITLE=Apps
DATABASE_URL=postgresql://user:password@localhost:5432/apps
## RLS-enforced app_user role for the app's `db` (dev loads the tenancy layer, which
## refuses requests if this role bypasses RLS). See documentation/tenancy.md.
APP_DATABASE_URL=postgresql://app_user:password@localhost:5432/apps
NODE_ENV=development
## The dev server binds to localhost:2080 by default. Running several
## nuxtinator projects side by side? Give each its own cookie jar by setting
## NUXT_HOST to a named host (any *.localhost name works) and adding it to
## /etc/hosts, e.g.: NUXT_HOST=myproject.localhost + 127.0.0.1 myproject.localhost
## NUXT_PORT overrides the port. Keep NUXT_PUBLIC_SITE_URL in sync with both.
# NUXT_HOST=myproject.localhost
# NUXT_PORT=2080
NUXT_PUBLIC_SITE_URL=http://localhost:2080
## Which reverse proxies may speak for the client IP in X-Forwarded-For (used
## to key rate limits). Comma-separated presets (loopback, private, cloudflare),
## CIDRs or addresses. Default: loopback,private,cloudflare. Without
## Cloudflare in front, loopback,private is tighter.
## See documentation/deploy-behind-a-proxy.md.
# NUXT_TRUSTED_PROXIES=loopback,private

## Auth (JWT) — generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this

## Tenancy (only if @nuxtinator/tenancy is included) — generate with: openssl rand -base64 32
NUXT_TENANT_FLOW_SECRET=

## Email (Mailgun)
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.yourdomain.com
# Optional: Use 'api.eu.mailgun.net' for EU region
MAILGUN_HOST=
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=Apps

## Inbox (only if @nuxtinator/inbox is included)
# Webhook signing key — Mailgun Settings → API Keys → "HTTP webhook signing key"
# (a DIFFERENT key than MAILGUN_API_KEY; webhooks 401 if you swap them)
MAILGUN_WEBHOOK_SIGNING_KEY=
# Domain inbound mail is addressed to (MX → Mailgun catch-all route)
INBOX_DOMAIN=yourdomain.com
# Shared From identity + base of contact+<token> reply addresses
INBOX_CONTACT_ADDRESS=contact@yourdomain.com

## AI (only if @nuxtinator/ai is included). Each provider's host key can be set
## here or on Admin → AI; a key set here wins and can't be changed in the admin.
## Without any key the layer loads but generation returns 503; model selection
## still saves.
# OpenRouter (OpenAI-compatible; one key, many models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional — defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=
# Optional — OpenRouter attribution headers (shown on your OpenRouter dashboard)
AI_HTTP_REFERER=
AI_APP_TITLE=
# Optional — Tinfoil (confidential inference). Its models join the pickers as
# tinfoil/<model> once a Tinfoil key exists.
TINFOIL_API_KEY=
# Optional — defaults to https://api.tinfoil.sh/api/config/models
TINFOIL_CATALOG_URL=
# Optional — scopes Tinfoil's prompt cache; random per process when unset
TINFOIL_USER_CACHE_SECRET=
# Optional — OpenAI and Anthropic, called directly (models as openai-api/<id>
# and anthropic-api/<id>)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional — default to https://api.openai.com/v1 and https://api.anthropic.com/v1
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=

## Helpinator (only if @nuxtinator/helpinator is included) — scheduled re-sync of
## website libraries. Cron (UTC) for the check; set to "off" to disable.
# HELPINATOR_SYNC_CRON=0 2 * * *
## Re-crawl a source once its last sync is older than this many days.
# HELPINATOR_SYNC_MAX_AGE_DAYS=7

## S3 Storage
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_REGION=us-west-004
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=your-bucket-name
# Optional — dedicated public-read bucket for public uploads (bind a CDN custom
# domain to it). Falls back to S3_BUCKET_NAME if unset. Must be the same bucket
# that S3_PUBLIC_BASE_URL points at.
S3_PUBLIC_BUCKET_NAME=
# Optional — public read URL (the custom domain bound to the public bucket above).
# Required for public files.
S3_PUBLIC_BASE_URL=

## Social sign-in (@nuxtinator/social-auth). Each provider turns on when its
## web credentials are set. See layers/social-auth/README.md.
## Google redirect URI: <NUXT_PUBLIC_SITE_URL>/api/social-auth/google/callback
NUXT_SOCIAL_AUTH_GOOGLE_CLIENT_ID=
NUXT_SOCIAL_AUTH_GOOGLE_CLIENT_SECRET=
NUXT_SOCIAL_AUTH_GOOGLE_NATIVE_CLIENT_IDS=
## Apple return URL: <NUXT_PUBLIC_SITE_URL>/api/social-auth/apple/callback
NUXT_SOCIAL_AUTH_APPLE_SERVICES_ID=
NUXT_SOCIAL_AUTH_APPLE_TEAM_ID=
NUXT_SOCIAL_AUTH_APPLE_KEY_ID=
NUXT_SOCIAL_AUTH_APPLE_PRIVATE_KEY=
NUXT_SOCIAL_AUTH_APPLE_BUNDLE_IDS=

## OAuth layer — generate with: openssl rand -base64 32
OAUTH_CONSENT_COOKIE_SECRET=
OAUTH_ALLOW_DCR=true

## MCP layer
MCP_SERVER_NAME=Apps
MCP_SERVER_VERSION=1.0.0

## Secret encryption (used by layers that store encrypted credentials via core's secret-crypto)
## Generate with: openssl rand -hex 32   (must be exactly 64 hex chars / 32 bytes)
NUXT_SECRET_ENCRYPTION_KEY=

## Per-layer local override — point an individual layer at a sibling checkout on disk.
## Format: NUXTINATOR_<ID>_PATH (id uppercased, hyphens/slashes become underscores).
## Without an override, layers resolve as `@nuxtinator/<id>` from node_modules/
## (workspace symlink in dev; npm tarball or git URL when consumed externally).
# NUXTINATOR_CORE_PATH=../../my-core-checkout
# NUXTINATOR_MESSAGES_PATH=../../scratch/messages-experiment
# NUXTINATOR_EMAIL_MAILGUN_PATH=../../email-fork

## Testing — see scripts/setup-test-db.sh to provision the test DB + roles.
## TEST_DATABASE_URL connects as host_admin (BYPASSRLS) — used by migrations,
## test setup, and the tenancy adminDb.
## TEST_APP_DATABASE_URL connects as app_user (RLS-enforced) — what the Nuxt
## server's `db` client uses during test runs.
TEST_DATABASE_URL=postgresql://host_admin:test@localhost:5432/go_saas_test
TEST_APP_DATABASE_URL=postgresql://app_user:test@localhost:5432/go_saas_test
## Playwright test server port (must differ from dev's 2080).
TEST_BASE_URL=http://localhost:2090
## MailHog HTTP API used by tests to read captured verification emails.
TEST_MAILHOG_URL=http://localhost:8025
